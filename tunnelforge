set -e

VERSION="1.0.0"
CONF_DIR="/etc/tunnelforge"
CONF_FILE="/etc/tunnelforge/config.env"
GOST_BIN="/usr/local/bin/gost"
SERVICE_SERVER="tunnelforge-server.service"
SERVICE_CLIENT="tunnelforge-client.service"
XUI_DB="/etc/x-ui/x-ui.db"

# Color Codes
C_RESET="\033[0m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_BLUE="\033[1;34m"
C_MAGENTA="\033[1;35m"
C_CYAN="\033[1;36m"
C_BOLD="\033[1m"
C_DIM="\033[2m"

# Print Helpers
info()    { echo -e "${C_CYAN}[INFO]${C_RESET} $*"; }
success() { echo -e "${C_GREEN}[SUCCESS]${C_RESET} $*"; }
warn()    { echo -e "${C_YELLOW}[WARN]${C_RESET} $*"; }
error()   { echo -e "${C_RED}[ERROR]${C_RESET} $*"; }
title()   { echo -e "\n${C_BOLD}${C_MAGENTA}>>> $*${C_RESET}"; }

# Root Privilege Check
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "This script must be run as root. Please run with sudo or as root user."
        exit 1
    fi
}

# Architecture Detection
detect_arch() {
    local arch
    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64) echo "linux_amd64" ;;
        aarch64|arm64) echo "linux_arm64" ;;
        armv7*|armhf) echo "linux_armv7" ;;
        i386|i686) echo "linux_386" ;;
        *)
            error "Unsupported CPU architecture: $arch"
            exit 1
            ;;
    esac
}

# Dependency Installation
install_deps() {
    local pkgs=()
    command -v curl >/dev/null 2>&1 || pkgs+=(curl)
    command -v tar >/dev/null 2>&1 || pkgs+=(tar)
    command -v python3 >/dev/null 2>&1 || pkgs+=(python3)
    command -v ufw >/dev/null 2>&1 || pkgs+=(ufw)

    if [[ ${#pkgs[@]} -gt 0 ]]; then
        info "Installing required packages: ${pkgs[*]}..."
        if command -v apt-get >/dev/null 2>&1; then
            apt-get update -y && apt-get install -y "${pkgs[@]}"
        elif command -v dnf >/dev/null 2>&1; then
            dnf install -y "${pkgs[@]}"
        elif command -v yum >/dev/null 2>&1; then
            yum install -y "${pkgs[@]}"
        elif command -v pacman >/dev/null 2>&1; then
            pacman -Sy --noconfirm "${pkgs[@]}"
        fi
    fi
}

# Ensure GOST Core Binary is Installed
install_gost() {
    if [[ -x "$GOST_BIN" ]]; then
        local cur_ver
        cur_ver=$("$GOST_BIN" -V 2>/dev/null || echo "installed")
        info "GOST core is already available: ${cur_ver}"
        return 0
    fi

    info "Fetching latest GOST v3 core release from GitHub..."
    local arch
    arch=$(detect_arch)
    local tag
    tag=$(curl -sSL "https://api.github.com/repos/go-gost/gost/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || echo "")
    if [[ -z "$tag" ]]; then
        tag="v3.3.3"
    fi
    local ver_clean="${tag#v}"

    local download_url="https://github.com/go-gost/gost/releases/download/${tag}/gost_${ver_clean}_${arch}.tar.gz"
    info "Downloading GOST ${tag} (${arch}) from ${download_url}..."

    local tmp_dir
    tmp_dir=$(mktemp -d)
    if ! curl -sSL "$download_url" -o "${tmp_dir}/gost.tar.gz"; then
        error "Failed to download GOST archive. Please check your internet connection."
        rm -rf "$tmp_dir"
        exit 1
    fi

    tar -xzf "${tmp_dir}/gost.tar.gz" -C "$tmp_dir"
    if [[ -f "${tmp_dir}/gost" ]]; then
        mv "${tmp_dir}/gost" "$GOST_BIN"
        chmod +x "$GOST_BIN"
        success "GOST core installed successfully to $GOST_BIN"
    else
        error "Failed to extract GOST binary from archive."
        rm -rf "$tmp_dir"
        exit 1
    fi
    rm -rf "$tmp_dir"
}

