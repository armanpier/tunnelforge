# 8. UPDATE CORE (GOST & TUNNELFORGE)
# ------------------------------------------------------------------------------
update_core() {
    title "Update Core & Scripts"
    rm -f "$GOST_BIN"
    install_gost

    info "Updating TunnelForge CLI script from GitHub..."
    local script_url="https://raw.githubusercontent.com/armanpier/TunnelForge/main/tunnelforge"
    if curl -sSL "$script_url" -o "$0"; then
        chmod +x "$0"
        success "TunnelForge updated to latest version successfully!"
    else
        warn "Could not fetch latest script directly from GitHub."
    fi

    # Restart services if active
    systemctl restart "$SERVICE_SERVER" 2>/dev/null || true
    systemctl restart "$SERVICE_CLIENT" 2>/dev/null || true
    read -rp "Press Enter to return to menu..."
}

# ------------------------------------------------------------------------------
# 9. UNINSTALL TUNNELFORGE
# ------------------------------------------------------------------------------
uninstall_tunnelforge() {
    title "Uninstall TunnelForge"
    read -rp "Are you sure you want to completely uninstall TunnelForge? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Uninstallation canceled."
        return 0
    fi

    info "Stopping and disabling services..."
    systemctl stop "$SERVICE_SERVER" "$SERVICE_CLIENT" 2>/dev/null || true
    systemctl disable "$SERVICE_SERVER" "$SERVICE_CLIENT" 2>/dev/null || true
    rm -f "/etc/systemd/system/${SERVICE_SERVER}" "/etc/systemd/system/${SERVICE_CLIENT}"
    systemctl daemon-reload

    info "Removing configuration and binaries..."
    rm -rf "$CONF_DIR"
    rm -f "$GOST_BIN"
    rm -f "/usr/local/bin/tunnelforge" "/usr/local/bin/tunnel"

    success "TunnelForge has been completely uninstalled from this server."
    exit 0
}

