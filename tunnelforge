service_control() {
    title "Service Control & Diagnostics"
    echo "  1) Check Status of TunnelForge Services"
    echo "  2) View Realtime Live Logs"
    echo "  3) Restart TunnelForge Services"
    echo "  4) Stop TunnelForge Services"
    echo "  5) Check Listening Network Ports (ss/netstat)"
    echo "  0) Back to Main Menu"
    read -rp "Select option [0-5]: " sopt

    case "$sopt" in
        1)
            echo ""
            systemctl status "$SERVICE_SERVER" "$SERVICE_CLIENT" --no-pager 2>/dev/null || true
            echo ""
            read -rp "Press Enter to continue..."
            ;;
        2)
            echo "Streaming live logs (Press Ctrl+C to exit)..."
            journalctl -u "$SERVICE_SERVER" -u "$SERVICE_CLIENT" -f
            ;;
        3)
            systemctl restart "$SERVICE_SERVER" 2>/dev/null || true
            systemctl restart "$SERVICE_CLIENT" 2>/dev/null || true
            success "Services restarted."
            read -rp "Press Enter to continue..."
            ;;
        4)
            systemctl stop "$SERVICE_SERVER" 2>/dev/null || true
            systemctl stop "$SERVICE_CLIENT" 2>/dev/null || true
            warn "Services stopped."
            read -rp "Press Enter to continue..."
            ;;
        5)
            echo ""
            if command -v ss >/dev/null 2>&1; then
                ss -tulpn | grep -E "gost|xray|x-ui" || ss -tulpn
            else
                netstat -tulpn
            fi
            echo ""
            read -rp "Press Enter to continue..."
            ;;
        *) return 0 ;;
    esac
}

